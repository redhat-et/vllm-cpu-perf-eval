#!/bin/bash
# Launcher script for cpueval
# Creates venv if needed, then runs cpueval CLI

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_DIR="$SCRIPT_DIR/automation/cli"
VENV_DIR="$CLI_DIR/.venv"

# Create venv if it doesn't exist
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment at $VENV_DIR..."
    if ! python3 -m venv "$VENV_DIR"; then
        rm -rf "$VENV_DIR"
        echo "Error: Failed to create virtual environment" >&2
        exit 1
    fi

    echo "Installing cpueval..."
    if ! "$VENV_DIR/bin/pip" install --quiet --upgrade pip; then
        rm -rf "$VENV_DIR"
        echo "Error: Failed to upgrade pip" >&2
        exit 1
    fi
    if ! "$VENV_DIR/bin/pip" install --quiet -e "$CLI_DIR"; then
        rm -rf "$VENV_DIR"
        echo "Error: Failed to install cpueval" >&2
        exit 1
    fi
fi

# Run cpueval
exec "$VENV_DIR/bin/python" -m cpueval "$@"
