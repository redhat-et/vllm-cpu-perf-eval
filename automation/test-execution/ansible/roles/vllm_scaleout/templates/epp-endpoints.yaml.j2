# EPP endpoints file - consumed by the file-discovery plugin.
# Each entry uses a literal IPv4 address (hostnames are not resolved).
# With watchFile: true in epp-config.yaml, the EPP reloads this file
# automatically on atomic rewrite without requiring a restart.
endpoints:
{% for i in range(1, scaleout_num_instances + 1) %}
  - name: vllm-{{ i }}
    address: 127.0.0.1
    port: "{{ scaleout_vllm_base_port + i - 1 }}"
    labels:
      model: {{ scaleout_model_name }}
{% endfor %}
